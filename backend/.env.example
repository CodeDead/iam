# Application environment: development | production
APP_ENV=development

# HTTP Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# MongoDB (MONGODB_DATABASE can be set to any target database name; defaults to user_management)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=user_management
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# JWT Configuration (Ed25519 PKCS#8 PEM keys)
# Generate keys with:
#   openssl genpkey -algorithm ED25519 -out private_key.pem
#   openssl pkey -in private_key.pem -pubout -out public_key.pem
JWT_ISSUER=user-management-api
JWT_AUDIENCE=user-management-client
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
REVOKED_TOKEN_RETENTION_SECONDS=3600
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Cookies (set COOKIE_SECURE=true in production over HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# Rate limiting, caching & proxy trust
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=300
TRUST_PROXY_HEADERS=false
PERMISSION_CACHE_TTL_SECONDS=30
REQUIRE_EMAIL_VERIFICATION=false

# OpenAPI / Swagger UI (defaults to true in development, false in production)
ENABLE_SWAGGER_UI=true

# Audit log retention in days (0 disables/drops TTL index)
AUDIT_LOG_RETENTION_DAYS=90

# Optional initial Super Administrator bootstrap (only creates if none exists)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=System
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Administrator

# Logging
RUST_LOG=info,auth_backend=debug
