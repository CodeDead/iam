# Portainer Stack Environment Variables for deploy/swarm-stack.yml
# Upload via Portainer -> Stacks -> Environment variables -> "Load variables from .env file"
# Never commit real secrets or production credentials to Git.

# Pre-built GHCR images (published by .github/workflows/docker-publish.yml)
# For production rollouts, pin to a specific semver or sha-* tag instead of :latest.
BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:v1.0.0
FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:v1.0.0

# Reverse proxy / Traefik configuration
APP_DOMAIN=iam.yourdomain.com
PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# MongoDB Atlas (M0 Free Tier or higher)
# Ensure special characters in the password are URL-encoded and Swarm node IP(s) are whitelisted in Atlas.
# Tip: You can also mount a Docker Swarm secret and set MONGODB_URI_FILE=/run/secrets/mongodb_uri instead of MONGODB_URI.
MONGODB_URI=mongodb+srv://codedead_api:URL_ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=CodeDeadIAM
MONGODB_DATABASE=user_management
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# JWT claims & TTLs
JWT_ISSUER=https://iam.yourdomain.com
JWT_AUDIENCE=https://iam.yourdomain.com
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
REVOKED_TOKEN_RETENTION_SECONDS=3600

# CORS & Cookies (same-domain /api routing uses Lax and no cross-subdomain cookie needed)
FRONTEND_URL=https://iam.yourdomain.com
ALLOWED_ORIGINS=https://iam.yourdomain.com
# Optional comma-separated WebView / desktop origins permitted to use JSON-body refresh tokens (e.g. tauri://localhost,http://tauri.localhost)
ALLOWED_BODY_TOKEN_ORIGINS=
ALLOW_BODY_REFRESH_TOKENS=true
REJECT_BROWSER_ORIGIN_FOR_BODY_TOKENS=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# Rate limiting, security & RBAC cache
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
TRUST_PROXY_HEADERS=true
ENABLE_SWAGGER_UI=false
REQUIRE_EMAIL_VERIFICATION=false
AUDIT_LOG_RETENTION_DAYS=90
PERMISSION_CACHE_TTL_SECONDS=30

# Initial Super Administrator bootstrap (remove password after first sign-in & password rotation!)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ReplaceWithVeryStrongInitialPassword!99
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=System
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Administrator

# Logging
RUST_LOG=info,auth_backend=info
